@page "/RentalDetailsEmployee/{apiID:int}/{rentalId:int}/"
@using MiNICarRentalBrowser.Components.Components
@using MiNICarRentalBrowser.Services
@using MiNICarRentalBrowser.Services.Car_Service
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using SharedDataModels
@using System.Security.Claims
@rendermode InteractiveServer
@inject AggregatedCarService aggregatedCarService
@inject IUserService userService
@inject AuthenticationStateProvider authenticationStateProvider
@inject IAuthorizationService AuthorizationService
@inject NavigationManager navigation

<div class="container">

	@if (_isCarLoaded)
	{
		<CarDisplay car="_car" />
	}
	<div class="card">
		@if (_isCarLoaded)
		{
			<LocationDisplay car="_car" />
			<RentalDisplay rental="_rental" />
			if (_rental != null && _rental.RentalStatus == RentalStatus.RETURNED)
			{
				<button @onclick="() => AcceptReturnAction()" class="button">Akceptuj Zwrot</button>
			}
		}
		else
		{
			<p>Loading Rental Details...</p>
		}
	</div>
	<div class="card">
		@if (_rental != null && _rental.RentalStatus == RentalStatus.CLOSED)
		{
			<CarImageDisplay rental="_rental" />
		}
	</div>
</div>

@code {
	[Parameter]
	public int rentalId { get; set; }
	public int apiId { get; set; }
	private Rental _rental { get; set; }
	private Car _car;
	private bool _isCarLoaded = false;


	protected override async Task OnInitializedAsync()
	{
		var authState = await authenticationStateProvider.GetAuthenticationStateAsync();
		var user = authState.User;
		if (!(await AuthorizationService.AuthorizeAsync(user, "EmployeePolicy")).Succeeded)
		{
			navigation.NavigateTo("/", true);
		}
		await base.OnInitializedAsync();

		_rental = await aggregatedCarService.GetRentalAsync(rentalId, apiId);
		if (_rental != null)
			_car = await aggregatedCarService.GetCarDetailsAsync(_rental.SourceAPI, _rental.CarID);
		_isCarLoaded = true;
	}
	public void AcceptReturnAction()
	{
		navigation.NavigateTo($"/acceptReturn/{rentalId}", true);//?returnUrl={Uri.EscapeDataString(returnUrl)}");
	}
}
