@page "/RentalDetailsEmployee/{rentalId:int}"
@using Browser_FrontEnd.Services
@using MiNICarRentalBrowser.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using SharedDataModels
@using System.Security.Claims
@rendermode InteractiveServer
@inject RentalServicecs rentalService
@inject IUserService userService
@inject AuthenticationStateProvider authenticationStateProvider
@inject IAuthorizationService AuthorizationService
@inject NavigationManager navigation

<div class="container">
	<div class="card">
		@if (_isCarLoaded)
		{
			string address = $"{_car.Latitude}, {_car.Longitude}";
			string searchAddress = "https://www.google.com/maps/search/?api=1&query=" + $"{_car.Latitude.ToString().Replace(',', '.')},{_car.Longitude.ToString().Replace(',', '.')}";
			<h3>Szczegóły samochodu</h3>
			<p><strong>Brand:</strong> @_car.Model.Brand.Name</p>
			<p><strong>Model:</strong> @_car.Model.Name</p>
			<p><strong>Production Year:</strong> @_car.ProductionYear</p>
			<p><strong>Doors:</strong> @_car.DoorsNumber</p>
			<p><strong>Transmission:</strong> @_car.Transmission</p>
			<p><strong>Colour:</strong> @char.ToUpper(_car.Colour[0])@_car.Colour.Substring(1)</p>
			<p><strong>Drive:</strong> @_car.Drive</p>
			<p><strong>FuelType:</strong> @_car.FuelType</p>
			<p><strong>HorsePower:</strong> @_car.HorsePower HP</p>
			<p><strong>Location: </strong><a href=@searchAddress>@address</a></p>
		}
		else
		{
			<p>Loading Car Details...</p>
		}
	</div>

	<div class="card">
		@if (_isCarLoaded)
		{
			<h3>Location</h3>
			string source = $"https://www.google.com/maps?q={@_car.Latitude.ToString().Replace(',', '.')},{@_car.Longitude.ToString().Replace(',', '.')}&z=15&output=embed";
			<iframe width="100%"
					height="300"
					style="border:0"
					loading="lazy"
					allowfullscreen
					referrerpolicy="no-referrer-when-downgrade"
					src=@source>
			</iframe>
			<h3>Rental Details</h3>
			<p><strong>Insurance: </strong>@_rental.IsInsurance</p>
			<p><strong>Price Per Day: </strong>@_rental.PricePerDay</p>
			<p><strong>Rent Date: </strong>@_rental.RentDate</p>
			<p><strong>User: </strong>@_rental.UserEmail</p>
			<p><strong>Status: </strong>@_rental.RentalStatus</p>
			if (_rental.RentalStatus == RentalStatus.RETURNED)
			{
				<button @onclick="() => AcceptReturnAction()" class="button">Akceptuj Zwrot</button>
			}
		}
		else
		{
			<p>Loading Rental Details...</p>
		}
	</div>
</div>


@code {
	[Parameter]
	public int rentalId { get; set; }
	private Rental _rental { get; set; }
	private Car _car;

	private bool _isCarLoaded = false;


	protected override async Task OnInitializedAsync()
	{
		var authState = await authenticationStateProvider.GetAuthenticationStateAsync();
		var user = authState.User;
		if (!(await AuthorizationService.AuthorizeAsync(user, "EmployeePolicy")).Succeeded)
		{
			navigation.NavigateTo("/", true);
		}
		await base.OnInitializedAsync();

		_rental = await rentalService.GetRentalAsync(rentalId);
		_car = await rentalService.GetCarDetailsAsync(_rental.CarID);
		if (_car != null)
		{
			_isCarLoaded = true;
		}
		await InvokeAsync(StateHasChanged);
	}
	public void AcceptReturnAction()
	{
		navigation.NavigateTo($"/acceptReturn", true);//?returnUrl={Uri.EscapeDataString(returnUrl)}");
	}
}

<style>
	.container {
		display: flex;
		flex-wrap: wrap;
		gap: 20px;
		padding: 20px;
		font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
		justify-content: center;
		align-items: flex-start;
		max-width: 1200px;
		margin: 0 auto;
	}

	.card {
		border-radius: 12px;
		padding: 20px;
		width: 100%;
		max-width: 450px;
		box-shadow: 0 10px 20px rgba(186, 104, 200, 0.3), 0 6px 6px rgba(0, 0, 0, 0.1);
		align-self: center
	}

		.card h3 {
			border-bottom: 2px solid #AB47BC;
			padding-bottom: 8px;
			margin-bottom: 15px;
			font-size: 1.3rem;
		}

		.card p {
			font-size: 1rem;
			line-height: 1.6;
			margin-bottom: 10px;
		}

	.offer-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 10px;
	}

	a {
		color: #1E90FF;
		text-decoration: underline;
		cursor: pointer;
	}

		a:hover {
			color: #FF4500;
		}
</style>