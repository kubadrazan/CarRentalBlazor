@page "/registration"
@using MudBlazor
@using System.Threading
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Browser_FrontEnd.Services
@using SharedDataModels
@inject NavigationManager Navigation
@inject RentalServicecs rentalService
@inject AuthenticationStateProvider authenticationStateProvider
@inject Services.IUserService UserService

<style>
    .centered-top {
        position: absolute;
        left: 50%;
        transform: translate(-50%, 0);
    }

    .reg_btn {
        margin-left: 40px;
        margin-right: 40px;
        margin-top: 40px;
    }

    .purple-accents > .mud-input-control-input-container > .mud-input.mud-input-outlined > /* input:focus ~ */ .mud-input-outlined-border {
        border-color: #A64DB6;
        border-width: 3px
    }

    .gray-accents > .mud-input-control-input-container > .mud-input.mud-input-outlined > /* input:focus ~ */ .mud-input-outlined-border {
        border-color: #808080;
        border-width: 3px
    }
</style>

<MudThemeProvider Theme="MyCustomTheme" />
<MudContainer Style="justify-content: center">
    <MudCard Class="rounded-xl centered-top" Style="padding-top:20px;
    padding-left:50px; padding-right:50px; padding-bottom:20px;">
        <MudStack Style="width: 300px;" Justify="Justify.Center">
            <MudTextField @bind-Value="_email" Label="Email" ReadOnly="true" Variant="Variant.Outlined" Class="purple-accents" />

            <MudTextField @bind-Value="_firstName" Label="First Name" Variant="Variant.Outlined" Class="purple-accents"
                          MaxLength="50" InputMode="InputMode.text" InputType="InputType.Text" />

            <MudTextField @bind-Value="_lastName" Label="Last Name" Variant="Variant.Outlined" Class="purple-accents"
                          MaxLength="50" InputMode="InputMode.text" InputType="InputType.Text" />

            <MudDatePicker Label="Birth date" @bind-Date="_birthDate" Placeholder="Select Date"
                           PickerVariant="PickerVariant.Dialog" Color="Color.Secondary" Rounded="true"
                           Style="margin-top: 20px;" />

            <MudDatePicker Label="Driving license obtain date" @bind-Date="_drivingLicenseDate" Placeholder="Select Date"
                           PickerVariant="PickerVariant.Dialog" Color="Color.Secondary" Rounded="true"
                           Style="margin-top: 20px;" />


            <button @onclick=Register class="button reg_btn">Register</button>
        </MudStack>
    </MudCard>

</MudContainer>

@if (_showAlert)
{
    <MudCard Class="centered-top rounded-xl">
        <MudAlert @bind-Value="_alertText" Class="rounded-xl" Severity="Severity.Error" ShowCloseIcon="true"
                  CloseIconClicked="(() => CloseAlert(true))"></MudAlert>
    </MudCard>
}

@code {
    MudTheme MyCustomTheme = new MudTheme()
        {
            PaletteLight = new PaletteLight()
            {
                Secondary = Colors.Purple.Lighten1
            }
        };

    private string _email = "";
    private string _firstName = "";
    private string _lastName = "";
    private DateTime? _birthDate = DateTime.Today;
    private DateTime? _drivingLicenseDate = DateTime.Today;

    private bool _showAlert = false;
    private string _alertText = "";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        var authState = await authenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var email = user.FindFirstValue(ClaimTypes.Email);
        if (email is null)
        {
            // todo cos
        }

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            // todo pozniej pomyslimy
        }

        _email = email ?? "";
    }

    private async Task Register()
    {
        if (String.IsNullOrEmpty(_firstName))
        {
            await ShowAlert("Enter first name", 5000);
            return;
        }

        if (String.IsNullOrEmpty(_lastName))
        {
            await ShowAlert("Enter last name", 5000);
            return;
        }

        if (_birthDate is null)
        {
            await ShowAlert("Choose birth date", 5000);
            return;
        }

        if (_drivingLicenseDate is null)
        {
            await ShowAlert("Choose driving license obtain date", 5000);
            return;
        }

        if (((DateTime)_birthDate).AddYears(18) > DateTime.Now)
        {
            await ShowAlert("You must be at least 18 years old", 5000);
            return;
        }


        User user = new User
        {
                FirstName = _firstName,
                LastName = _lastName,
                BirthDate = (DateTime)_birthDate,
                DrivingLicenseObtainDate = (DateTime)_drivingLicenseDate
        };

        await UserService.AddUser(user);

        Navigation.NavigateTo("/");
        StateHasChanged();
    }

    public async Task ShowAlert(string text, int delay)
    {
        _alertText = text;
        _showAlert = true;
        await Task.Delay(delay);
        CloseAlert(true);
        await InvokeAsync(StateHasChanged);
    }

    private void CloseAlert(bool value)
    {
        _showAlert = !value;
    }
}
