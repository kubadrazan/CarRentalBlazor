@page "/RentalDetailsClient/{rentalId:int}"
@using Browser_FrontEnd.Services
@using MiNICarRentalBrowser.Components.Components
@using MiNICarRentalBrowser.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using SharedDataModels
@using System.Security.Claims
@rendermode InteractiveServer
@inject RentalServicecs rentalService
@inject IUserService userService
@inject AuthenticationStateProvider authenticationStateProvider
@inject IAuthorizationService AuthorizationService
@inject NavigationManager navigation

<div class="container">
	@if (_isCarLoaded)
	{
		<CarDisplay car="_car" />
	}
	<div class="card">
		@if (_isCarLoaded)
		{
			<LocationDisplay car="_car" />
			<RentalDisplay rental="_rental" />

			if (_rental != null && _rental.RentalStatus == RentalStatus.ACTIVE)
			{
				<button @onclick="() => ReturnAction()" class="button">Zamów zwrot</button>
			}
		}
		else
		{
			<p>Loading Rental Details...</p>
		}
	</div>
</div>


@code {
	[Parameter]
	public int rentalId { get; set; }
	private Rental _rental { get; set; }
	private Car _car;

	private bool _isCarLoaded = false;


	protected override async Task OnInitializedAsync()
	{
		var authState = await authenticationStateProvider.GetAuthenticationStateAsync();
		var user = authState.User;
		if (!(await AuthorizationService.AuthorizeAsync(user, "RegisteredPolicy")).Succeeded)
		{
			navigation.NavigateTo("/", true);
		}
		await base.OnInitializedAsync();

		_rental = await rentalService.GetRentalAsync(rentalId);
		var email = user.FindFirstValue(ClaimTypes.Email);
		if (_rental != null)
		{
			if (email != _rental.UserEmail)
			{
				navigation.NavigateTo("/home", true);
			}
			_car = await rentalService.GetCarDetailsAsync(_rental.CarID);
		}

		_isCarLoaded = true;

	}
	public async void ReturnAction()
	{
		await rentalService.ReturnCarAsync(_rental);
		navigation.NavigateTo(navigation.Uri, forceLoad: true);

	}
}

<style>
	.container {
		display: flex;
		flex-wrap: wrap;
		gap: 20px;
		padding: 20px;
		font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
		justify-content: center;
		align-items: flex-start;
		max-width: 1200px;
		margin: 0 auto;
	}

	.card {
		border-radius: 12px;
		padding: 20px;
		width: 100%;
		max-width: 450px;
		box-shadow: 0 10px 20px rgba(186, 104, 200, 0.3), 0 6px 6px rgba(0, 0, 0, 0.1);
		align-self: center
	}

		.card h3 {
			border-bottom: 2px solid #AB47BC;
			padding-bottom: 8px;
			margin-bottom: 15px;
			font-size: 1.3rem;
		}

		.card p {
			font-size: 1rem;
			line-height: 1.6;
			margin-bottom: 10px;
		}

	.offer-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 10px;
	}

	a {
		color: #1E90FF;
		text-decoration: underline;
		cursor: pointer;
	}

		a:hover {
			color: #FF4500;
		}
</style>