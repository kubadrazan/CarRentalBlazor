@page "/RentalDetailsClient/{rentalId:int}"
@using Browser_FrontEnd.Services
@using MiNICarRentalBrowser.Components.Components
@using MiNICarRentalBrowser.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using SharedDataModels
@using System.Security.Claims
@rendermode InteractiveServer
@inject RentalServicecs rentalService
@inject IUserService userService
@inject AuthenticationStateProvider authenticationStateProvider
@inject IAuthorizationService AuthorizationService
@inject NavigationManager navigation

<div class="container">
	@if (_isCarLoaded)
	{
		<CarDisplay car="_car" />
	}
	<div class="card">
		@if (_isCarLoaded)
		{
			<LocationDisplay car="_car" />
			<RentalDisplay rental="_rental" />

			if (_rental != null && _rental.RentalStatus == RentalStatus.ACTIVE)
			{
				<button @onclick="() => ReturnAction()" class="button">Zamów zwrot</button>
			}
		}
		else
		{
			<p>Loading Rental Details...</p>
		}
	</div>
	<div class="card">
		@if (_rental != null && _rental.RentalStatus == RentalStatus.CLOSED)
		{
			<CarImageDisplay rental="_rental" />
		}
	</div>
</div>


@code {
	[Parameter]
	public int rentalId { get; set; }
	private Rental _rental { get; set; }
	private Car _car;

	private bool _isCarLoaded = false;


	protected override async Task OnInitializedAsync()
	{
		var authState = await authenticationStateProvider.GetAuthenticationStateAsync();
		var user = authState.User;
		if (!(await AuthorizationService.AuthorizeAsync(user, "RegisteredPolicy")).Succeeded)
		{
			navigation.NavigateTo("/", true);
		}
		await base.OnInitializedAsync();

		_rental = await rentalService.GetRentalAsync(rentalId);
		var email = user.FindFirstValue(ClaimTypes.Email);
		if (_rental != null)
		{
			if (email != _rental.UserEmail)
			{
				navigation.NavigateTo("/home", true);
			}
			_car = await rentalService.GetCarDetailsAsync(_rental.CarID);
		}

		_isCarLoaded = true;

	}
	public async void ReturnAction()
	{
		await rentalService.ReturnCarAsync(_rental);
		navigation.NavigateTo(navigation.Uri, forceLoad: true);
	}
}