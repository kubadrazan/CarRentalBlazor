@page "/car-browser"
@using SharedDataModels
@using System.Linq
@using Browser_FrontEnd.Services
@using SharedDataModels.DTO
@using MiNICarRentalBrowser.Services.Car_Service
@rendermode RenderMode.InteractiveServer
@inject NavigationManager Navigation
@inject RentalServicecs rentalService
@inject AggregatedCarService aggregatedCarService

<MudContainer>
    <MudGrid>
        <!-- Filtry dla małych ekranów -->
        <MudItem xs="12" sm="12" Class="d-flex d-md-none mb-2" Style="justify-content: center">
            <MudPaper Class="pa-2" Outlined="true">
                <MudStack Row="true" Wrap="Wrap.NoWrap" Spacing="1">
                    <MudItem>
                        <MudSelect Style="width: 230px" MultiSelectionTextFunc="@(new Func<List<string>, string>(GetBrandsMultiSelectionText))" MultiSelection="true" @bind-SelectedValues="brandOptions" T="string" AdornmentIcon="@Icons.Material.Filled.Search"
                        AnchorOrigin="Origin.BottomCenter" Label="Brands" Variant="Variant.Outlined">
                            @if (uniqueBrands != null)
                            {
                                @foreach (var brand in uniqueBrands)
                                {
                                    <MudSelectItem T="string" Value="@brand">@brand</MudSelectItem>
                                }
                            }
                            else
                            {
                                <p>Loading...</p>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem>
                        <MudSelect Style="width: 230px" MultiSelectionTextFunc="@(new Func<List<string>, string>(GetModelsMultiSelectionText))" MultiSelection="true" @bind-SelectedValues="modelOptions" T="string"
                        AdornmentIcon="@Icons.Material.Filled.Search" AnchorOrigin="Origin.BottomCenter" Label="Models" Variant="Variant.Outlined">
                            @if (uniqueModels != null)
                            {
                                @foreach (var model in uniqueModels)
                                {
                                    <MudSelectItem T="string" Value="@model">@model</MudSelectItem>
                                }
                            }
                            else
                            {
                                <p>Loading...</p>
                            }
                        </MudSelect>
                    </MudItem>
                </MudStack>
                <MudButton Variant="Variant.Filled" Class="pa-2 mt-2 ml-auto" Color="Color.Primary" Style="display: block;" OnClick="ApplyFiltersButtonClick">
                    Apply filters
                </MudButton>
            </MudPaper>
        </MudItem>

        <!-- Filtry dla dużych ekranów -->
        <MudItem xs="0" sm="0" md="4" Class="d-none d-md-block">
            <MudPaper Elevation="1" Class="pa-4" Width="310px">
                <MudText Typo="Typo.h6">Filters</MudText>
                <MudDivider Class="my-2" />
                <MudExpansionPanels MultiExpansion="true" Outlined="false" Elevation="0">
                    <MudExpansionPanel Text="Brands" Expanded="true">
                        @if (uniqueBrands != null)
                        {
                            @foreach (var brand in uniqueBrands)
                            {
                                <MudCheckBox T="bool" Label="@brand" Value="@brandOptions.Contains(brand)" ValueChanged="value => OnBrandSelectionChanged(brand, value)" />
                            }
                        }
                        else
                        {
                            <p>Loading...</p>
                        }
                    </MudExpansionPanel>
                    <MudExpansionPanel Text="Models">
                        <MudStack Justify="Justify.Center" Class="mud-width-full">
                            <MudSelect MultiSelectionTextFunc="@(new Func<List<string>, string>(GetModelsMultiSelectionText))" MultiSelection="true" @bind-SelectedValues="modelOptions" T="string"
                            AdornmentIcon="@Icons.Material.Filled.Search" AnchorOrigin="Origin.BottomCenter" Label="Models" Variant="Variant.Outlined">
                                @if (uniqueModels != null)
                                {
                                    @foreach (var model in uniqueModels)
                                    {
                                        <MudSelectItem T="string" Value="@model">@model</MudSelectItem>
                                    }
                                }
                                else
                                {
                                    <p>Loading...</p>
                                }
                            </MudSelect>
                            <MudChipSet T="string" AllClosable="true" CheckMark="true" SelectionMode="SelectionMode.MultiSelection" OnClose="OnChipClose">
                                @if (uniqueModels != null)
                                {
                                    @foreach (var model in modelOptions)
                                    {
                                        <MudChip Value="model" />
                                    }
                                }
                            </MudChipSet>
                        </MudStack>
                    </MudExpansionPanel>
                </MudExpansionPanels>
                <MudButton Variant="Variant.Filled" Class="pa-2 mt-2 ml-auto" Color="Color.Primary" Style="display: block;" OnClick="ApplyFiltersButtonClick">
                    Apply filters
                </MudButton>
            </MudPaper>
        </MudItem>

        <!-- Lista aut -->
        <MudItem xs="12" sm="12" md="8">
            <MiNICarRentalBrowser.Components.Shared.ItemListWithLoading collection="cars" collectionCount="filteredCarsCount" isLoading="isLoading"
            collectionSummaryText="Available cars:" emptyCollectionText="There are no result matching your criteria." RenderCard="RenderMyCard" />
        </MudItem>
    </MudGrid>
</MudContainer>

<div class="mt-5 mb-5 d-flex flex-column align-center">
    <MudPagination PageSize="@pageSize" Count="@pagesCount" SelectedChanged="OnPageChanged" />
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "brand")]
    public string[]? brands { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "model")]
    public string[]? models { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "pageInd")]
    public int? pageInd { get; set; }

    private bool isLoading = false;

    private IEnumerable<string> brandOptions { get; set; } = new HashSet<string>() { };
    private IEnumerable<string> modelOptions { get; set; } = new HashSet<string>() { };

    private List<CarCache> cars = new List<CarCache>();
    private List<string> uniqueBrands = new List<string>(); // Lista marek do selectBoxa
    private List<string> uniqueModels = new List<string>(); // Lista modeli do selectBoxa

    private int pageSize = 5;
    private int pagesCount = 1;
    private int filteredCarsCount = 0;

    protected override async Task OnInitializedAsync()
    {
        uniqueBrands = await aggregatedCarService.GetUniqueBrands();
        uniqueModels = await aggregatedCarService.GetUniqueModels();

        await base.OnInitializedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        if (brands != null)
            brandOptions = new HashSet<string>(brands) { };

        if (models != null)
            modelOptions = new HashSet<string>(models) { };

        if (pageInd == null || pageInd < 0)
            pageInd = 1;

        filteredCarsCount = aggregatedCarService.GetFilteredCarsCount(brandOptions.ToList(), modelOptions.ToList());
        cars = await aggregatedCarService.GetFilteredCars(brandOptions.ToList(), modelOptions.ToList(), pageInd, pageSize);

        if (filteredCarsCount % pageSize == 0 && filteredCarsCount != 0)
            pagesCount = filteredCarsCount / pageSize;
        else
            pagesCount = filteredCarsCount / pageSize + 1;

        if (pageInd > pagesCount)
            OnPageChanged(1);

        isLoading = false;
        await base.OnParametersSetAsync();
    }

    private void ApplyFiltersButtonClick()
    {
        pageInd = 1;
        UpdateUrl();
    }

    private void OnBrandSelectionChanged(string brand, bool state)
    {
        if (state)
        {
            if (!brandOptions.Contains(brand))
            {
                HashSet<string> hash = new HashSet<string>(brandOptions);
                hash.Add(brand);
                brandOptions = hash;
            }
        }
        else
        {
            HashSet<string> hash = new HashSet<string>(brandOptions);
            hash.Remove(brand);
            brandOptions = hash;
        }

    }

    private void OnPageChanged(int page)
    {
        pageInd = page;
        UpdateUrl();
    }

    private string GetBrandsMultiSelectionText(List<string> selectedValues)
    {
        return $"{string.Join(", ", selectedValues.Select(x => x))}";
    }

    private string GetModelsMultiSelectionText(List<string> selectedValues)
    {
        return $"{string.Join(", ", selectedValues.Select(x => x))}";
    }

    private void NavigateToCarDetails(int carId)
    {
        Navigation.NavigateTo($"/CarToRentDetails/{carId}");
    }

    private void OnChipClose(MudChip<string> chip) =>
        modelOptions = modelOptions.Where(x => x != chip.Value);

    private RenderFragment<object> RenderMyCard => item =>
    {
        if (item is CarCache car)
        {
            return@<MiNICarRentalBrowser.Components.Shared.CarCard car="car" OnButtonClicked="NavigateToCarDetails" buttonText="See offers" imgSrc="car.jpg" />;
        }
        else
        {
            return @<MudCard>
            <MudCardContent>
                <MudText Typo="Typo.body1">Unknown item type</MudText>
            </MudCardContent>
            </MudCard>;
        }
    };

    private void UpdateUrl()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        query.Remove("brand");
        query.Remove("model");
        query.Remove("pageSize");
        query.Remove("pageInd");

        query.Add("pageSize",pageSize.ToString());
        query.Add("pageInd", pageInd.ToString());

        foreach (var brand in brandOptions)
        {
            query.Add("brand", brand);
        }

        foreach (var model in modelOptions)
        {
            query.Add("model", model);
        }

        var newUri = $"{uri.GetLeftPart(UriPartial.Path)}?{query}";
        Navigation.NavigateTo(newUri, forceLoad: false);
    }
}
