@page "/rentalhistory-client"
@attribute [Authorize(Policy = "RegisteredPolicy")]

@using SharedDataModels
@using Browser_FrontEnd.Services
@using System.Security.Claims
@using MiNICarRentalBrowser.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@rendermode RenderMode.InteractiveServer
@inject NavigationManager Navigation
@inject RentalServicecs rentalService
@inject IUserService userService
@inject AuthenticationStateProvider authenticationStateProvider
@inject IAuthorizationService AuthorizationService

<MudContainer>
    <MudGrid>
        <!-- Lista wypożyczeń -->
        <MudItem xs="12" sm="12" md="12">
            <MudGrid Class="mt-4" Spacing="12">
                @if (rentals.Any())
                {
                    <MudItem xs="12" Style="margin: 5px; margin: auto">
                        <MudText Typo="Typo.h5">Your rentals: @userRentalsCount</MudText>
                    </MudItem>

                    @foreach (var rental in rentals)
                    {
                        <MudItem xs="12" Style="margin: 5px">
                            <MudPaper Class="p-4" Style="max-width: 600px; height: 125px; margin: auto" Elevation="4">
                                <MudGrid>
                                    <MudItem xs="7" sm="7">
                                        <div style="display: flex; flex-direction: column; align-items: flex-start; padding-left: 16px">
                                            <MudText Typo="Typo.h5">@rental.Item1.Car.Model.Brand.Name @rental.Item1.Car.Model.Name</MudText>
                                            <MudText Typo="Typo.body2" Class="my-1">Rented: @rental.Item1.RentDate.ToShortDateString()</MudText>
                                            @switch (rental.Item1.RentalStatus)
                                            {
                                                case RentalStatus.ACTIVE:
                                                    {
                                                        <MudText Typo="Typo.body2" Color="Color.Success" Class="my-1">Status: ACTIVE</MudText>
                                                        break;
                                                    }
                                                case RentalStatus.RETURNED:
                                                    {
                                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="my-1">Status: RETURNED</MudText>
                                                        break;
                                                    }
                                                case RentalStatus.CLOSED:
                                                    {
                                                        <MudText Typo="Typo.body2" Color="Color.Primary" Class="my-1">Status: CLOSED</MudText>
                                                        break;
                                                    }
                                            }
                                        </div>
                                    </MudItem>
                                    <MudItem xs="5" sm="5">
                                        <div style="display: flex; flex-direction: column; align-items: flex-end; padding-right: 16px">
                                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" OnClick="() => NavigateToRentalDetails(rental.Item1.ID)">See rental details</MudButton>
                                        </div>
                                    </MudItem>
                                </MudGrid>
                            </MudPaper>
                        </MudItem>
                    }
                }
                else if(isLoading)
                {
                    <MudItem xs="12" Style="margin: 5px; ">
                        <MudText Typo="Typo.h4" Color="Color.Primary" Class="text-center">Loading...</MudText>
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12" Style="margin: 5px">
                        <MudText Typo="Typo.h4" Color="Color.Secondary" Class="text-center">No rentals...</MudText>
                    </MudItem>
                }
            </MudGrid>
        </MudItem>
    </MudGrid>
</MudContainer>

<div class="mt-5 mb-5 d-flex flex-column align-center">
    <MudPagination ShowPageButtons="false" PageSize="@pageSize" Count="@pagesCount" SelectedChanged="OnPageChanged"/>
</div>

@code {

    [Parameter]
    [SupplyParameterFromQuery(Name = "lastId")]
    public int? lastId { get; set; }

    public int newLastId = 0; 

    private List<(Rental, int browserID)> rentals = new List<(Rental, int)>();

    bool isLoading = false;

    private int pageSize = 15;

    private int userRentalsCount = 0;

    private int pagesCount = 1;

    private void NavigateToRentalDetails(int rentalID)
    {
        Navigation.NavigateTo($"/RentalDetailsClient/{rentalID}", true);
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        var authState = await authenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            var email = user.FindFirstValue(ClaimTypes.Email);
            userRentalsCount = userService.GetUsersRentalsCount(email);
            if (userRentalsCount % pageSize == 0 && userRentalsCount != 0)
                pagesCount = userRentalsCount / pageSize;
            else
                pagesCount = userRentalsCount / pageSize + 1;

        }
        else
            Navigation.NavigateTo($"/login", true);
    }

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        await base.OnParametersSetAsync();

        var authState = await authenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            var email = user.FindFirstValue(ClaimTypes.Email);
            List<RentalBrowser> rentalsBrowser = await userService.GetUsersRentals(email, lastId, pageSize);
            if (rentalsBrowser.Count != 0)
            {
                newLastId = rentalsBrowser.Last().ID;
                Rental rental;
                foreach (var rent in rentalsBrowser)
                {
                    rental = await rentalService.GetRentalAsync(rent.ApiID);
                    if (rental != null)
                        rentals.Add((rental, rent.ID));
                }
            }
        }
        else
            Navigation.NavigateTo($"/login", true);
        isLoading = false;
    }

    private void OnPageChanged()
    {
        lastId = newLastId;
        UpdateUrl();
    }

    private void UpdateUrl()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        query.Remove("pageSize");
        query.Remove("lastId");

        query.Add("pageSize", pageSize.ToString());

        if (lastId.HasValue)
            query.Add("lastId", lastId.ToString());

        var newUri = $"{uri.GetLeftPart(UriPartial.Path)}?{query}";
        Navigation.NavigateTo(newUri, forceLoad: false);
    }
}