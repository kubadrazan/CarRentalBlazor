@page "/rentalconfirmation"
@using MiNICarRentalBrowser.Services.Car_Service
@inject AggregatedCarService aggregatedCarService
<h3>RentalConfirmation</h3>

@code {
	[Parameter]
	[SupplyParameterFromQuery(Name = "offer_id")]
	public Guid offerId { get; set; }

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		await base.OnAfterRenderAsync(firstRender);

		if (firstRender)
		{
			await aggregatedCarService.ConfirmOffer(offerId);
		}
	}
}