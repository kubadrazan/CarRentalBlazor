@page "/CarToRentDetails/{carID:int}"
@using Browser_FrontEnd.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using SharedDataModels
@using System.Security.Claims
@rendermode InteractiveServer
@inject RentalServicecs renatalService
@inject AuthenticationStateProvider authenticationStateProvider
@inject NavigationManager navigation
<div class="container">
	<div class="card">
		@if (_isCarLoaded)
		{

			@* string address = $"{_car.Localization.Country} {_car.Localization.City} {_car.Localization.Street} {_car.Localization.HouseNumber}"; todo zmienic xd*@
			<h3>Szczegóły samochodu</h3>
			<p><strong>Marka:</strong> @_car.Model.Brand.Name</p>
			<p><strong>Model:</strong> @_car.Model.Name</p>
			<p><strong>Rok produkcji:</strong> @_car.ProductionYear</p>
			@* <p><strong>Lokalizacja:</strong> @address</p> todo zmienic*@
		}
		else
		{
			<p>Wczytywanie danych samochodu...</p>
		}
	</div>

	<div class="card">
		<h3>Oferty</h3>
		@if (_areOffersLoaded)
		{
			@foreach (Offer offer in _offers)
			{
				<div class="offer-row">
					<p><strong>Cena: @offer.Price zł</strong> Ubezpieczenie: @offer.IsInsurance</p>
					<button @onclick="() => RentMeAction(offer.ID)" class="button">Rent Me</button>
				</div>
			}
		}
		else
		{
			<p>Loading offers...</p>
		}
	</div>
</div>


@code {
	[Parameter]
	public int carID { get; set; }
	private Car _car;

	private bool _areOffersLoaded = false;
	private bool _isCarLoaded = false;

	private List<Offer> _offers;

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();
		_car = await renatalService.GetCarDetailsAsync(carID);
		if (_car != null)
		{
			_isCarLoaded = true;
		}
		_offers = await renatalService.GetOffersAsync(carID);
		if (_offers == null)
		{
			_offers = new List<Offer>();
		}
		_areOffersLoaded = true;
		await InvokeAsync(StateHasChanged);
	}
	public async Task RentMeAction(int offerID)
	{
		var authState = await authenticationStateProvider.GetAuthenticationStateAsync();
		var user = authState.User;
		if (user.Identity != null && user.Identity.IsAuthenticated)
		{
			var email = user.FindFirstValue(ClaimTypes.Email);
			await renatalService.SendMail(offerID, email);
			navigation.NavigateTo("/check-mail");
		}
		else
		{
			var returnUrl = navigation.Uri;
			navigation.NavigateTo($"/login", true);//?returnUrl={Uri.EscapeDataString(returnUrl)}");
		}
	}
}

<style>
	.container {
		display: flex;
		flex-wrap: wrap;
		gap: 20px;
		padding: 20px;
		font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
		justify-content: center;
		align-items: flex-start;
		max-width: 1200px;
		margin: 0 auto;
	}

	.card {
		border-radius: 12px;
		padding: 20px;
		width: 100%;
		max-width: 450px;
		box-shadow: 0 10px 20px rgba(186, 104, 200, 0.3), 0 6px 6px rgba(0, 0, 0, 0.1);
		align-self: center
	}

		.card h3 {
			border-bottom: 2px solid #AB47BC;
			padding-bottom: 8px;
			margin-bottom: 15px;
			font-size: 1.3rem;
		}

		.card p {
			font-size: 1rem;
			line-height: 1.6;
			margin-bottom: 10px;
		}

	.offer-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 10px;
	}
</style>