@page "/CarToRentDetails/{carID:int}"
@using Browser_FrontEnd.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using SharedDataModels
@using System.Security.Claims
@rendermode InteractiveServer
@inject RentalServicecs renatalService
@inject AuthenticationStateProvider authenticationStateProvider
@inject NavigationManager navigation
<div class="container">
	<div class="card">
		@if (_isCarLoaded)
		{
			string address = $"{_car.Latitude}, {_car.Longitude}";
			string searchAddress = "https://www.google.com/maps/search/?api=1&query=" + $"{_car.Latitude.ToString().Replace(',', '.')},{_car.Longitude.ToString().Replace(',', '.')}";
			<h3>Szczegóły samochodu</h3>
			<p><strong>Brand:</strong> @_car.Model.Brand.Name</p>
			<p><strong>Model:</strong> @_car.Model.Name</p>
			<p><strong>Production Year:</strong> @_car.ProductionYear</p>
			<p><strong>Doors:</strong> @_car.DoorsNumber</p>
			<p><strong>Transmission:</strong> @_car.Transmission</p>
			<p><strong>Colour:</strong> @char.ToUpper(_car.Colour[0])@_car.Colour.Substring(1)</p>
			<p><strong>Drive:</strong> @_car.Drive</p>
			<p><strong>FuelType:</strong> @_car.FuelType</p>
			<p><strong>HorsePower:</strong> @_car.HorsePower HP</p>
			<p><strong>Location: </strong><a href=@searchAddress>@address</a></p>
		}
		else
		{
			<p>Loading Car Details...</p>
		}
	</div>

	<div class="card">
		<h3>Location</h3>
		@if (_isCarLoaded)
		{
			string source = $"https://www.google.com/maps?q={@_car.Latitude.ToString().Replace(',', '.')},{@_car.Longitude.ToString().Replace(',', '.')}&z=15&output=embed";
			<iframe width="100%"
					height="300"
					style="border:0"
					loading="lazy"
					allowfullscreen
					referrerpolicy="no-referrer-when-downgrade"
					src=@source>
			</iframe>
		}
		<h3>Offers</h3>
		@if (_areOffersLoaded)
		{
			@foreach (Offer offer in _offers)
			{
				<div class="offer-row">
					<p><strong>Price Per Day: @offer.Price zł</strong> Insurance: @offer.IsInsurance</p>
					<button @onclick="() => RentMeAction(offer.ID)" class="button">Rent Me</button>
				</div>
			}
		}
		else
		{
			<p>Loading offers...</p>
		}
	</div>
</div>


@code {
	[Parameter]
	public int carID { get; set; }
	private Car _car;

	private bool _areOffersLoaded = false;
	private bool _isCarLoaded = false;

	private List<Offer> _offers;

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();
		_car = await renatalService.GetCarDetailsAsync(carID);
		if (_car != null)
		{
			_isCarLoaded = true;
		}
		_offers = await renatalService.GetOffersAsync(carID);
		if (_offers == null)
		{
			_offers = new List<Offer>();
		}
		_areOffersLoaded = true;
		await InvokeAsync(StateHasChanged);
	}

	public async Task RentMeAction(int offerID)
	{
		var authState = await authenticationStateProvider.GetAuthenticationStateAsync();
		var user = authState.User;
		if (user.Identity != null && user.Identity.IsAuthenticated)
		{
			var email = user.FindFirstValue(ClaimTypes.Email);
			await renatalService.SendMail(offerID, email);
			navigation.NavigateTo("/check-mail");
		}
		else
		{
			var returnUrl = navigation.Uri;
			navigation.NavigateTo($"/login", true);//?returnUrl={Uri.EscapeDataString(returnUrl)}");
		}
	}
}

<style>
	.container {
		display: flex;
		flex-wrap: wrap;
		gap: 20px;
		padding: 20px;
		font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
		justify-content: center;
		align-items: flex-start;
		max-width: 1200px;
		margin: 0 auto;
	}

	.card {
		border-radius: 12px;
		padding: 20px;
		width: 100%;
		max-width: 450px;
		box-shadow: 0 10px 20px rgba(186, 104, 200, 0.3), 0 6px 6px rgba(0, 0, 0, 0.1);
		align-self: center
	}

		.card h3 {
			border-bottom: 2px solid #AB47BC;
			padding-bottom: 8px;
			margin-bottom: 15px;
			font-size: 1.3rem;
		}

		.card p {
			font-size: 1rem;
			line-height: 1.6;
			margin-bottom: 10px;
		}

	.offer-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 10px;
	}

	a {
		color: #1E90FF;
		text-decoration: underline;
		cursor: pointer;
	}

		a:hover {
			color: #FF4500;
		}
</style>