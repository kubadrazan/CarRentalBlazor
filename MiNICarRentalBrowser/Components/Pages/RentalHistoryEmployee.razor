@page "/rentalhistory-employee"
@attribute [Authorize(Policy = "EmployeePolicy")]


@using MiNICarRentalBrowser.Services.Car_Service
@using SharedDataModels
@using System.Security.Claims
@using MiNICarRentalBrowser.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@rendermode RenderMode.InteractiveServer
@inject NavigationManager Navigation
@inject AggregatedCarService rentalService
@inject IUserService userService
@inject AuthenticationStateProvider authenticationStateProvider
@inject IAuthorizationService AuthorizationService

<MudContainer>
    <MudGrid>
        <!-- Lista wypożyczeń -->
        <MudItem xs="12" sm="12" md="12">
            <MiNICarRentalBrowser.Components.Shared.ItemListWithLoading collection="rentals" collectionCount="rentalsCount" isLoading="isLoading"
             collectionSummaryText="Your rentals:" emptyCollectionText="No rentals..." RenderCard="RenderMyCard" />
        </MudItem>
    </MudGrid>
</MudContainer>

<div class="mt-5 mb-5 d-flex flex-column align-center">
    <MudPagination PageSize="@pageSize" Count="@pagesCount" SelectedChanged="OnPageChanged" />
</div>

@code {

    [Parameter]
    [SupplyParameterFromQuery(Name = "pageInd")]
    public int? pageInd { get; set; }

    private int pageSize = 15;

    private List<Rental> rentals = new List<Rental>();

    bool isLoading = false;

    private int rentalsCount = 0;

    private int pagesCount = 1;

    private void NavigateToRentalDetails(int rentalId)
    {
        Navigation.NavigateTo($"/RentalDetailsEmployee/{rentalId}", true);
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        rentalsCount = await rentalService.GetEmployeeRentalsCountAsync();
        if (rentalsCount % pageSize == 0 && rentalsCount != 0)
            pagesCount = rentalsCount / pageSize;
        else
            pagesCount = rentalsCount / pageSize + 1;
    }

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        await base.OnParametersSetAsync();
        if (pageInd == null || pageInd < 1 || pageInd > pagesCount)
            pageInd = 1;
        rentals = await rentalService.GetEmployeeRentalsAsync(pageInd, pageSize);
        isLoading = false;
    }

    private RenderFragment<object> RenderMyCard => item =>
    {
        if (item is Rental rental)
        {
            return@<MiNICarRentalBrowser.Components.Shared.RentalCard rental="@rental"
                    rentalID="rental.ID" OnButtonClicked="NavigateToRentalDetails" />;
        }
        else
        {
            return @<MudCard>
                        <MudCardContent>
                            <MudText Typo="Typo.body1">Unknown item type</MudText>
                        </MudCardContent>
                    </MudCard>;
        }
    };

    private void OnPageChanged(int page)
    {
        pageInd = page;
        rentals.Clear();
        UpdateUrl();
    }

    private void UpdateUrl()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        query.Remove("pageInd");
        query.Add("pageInd", pageInd.ToString());

        var newUri = $"{uri.GetLeftPart(UriPartial.Path)}?{query}";
        Navigation.NavigateTo(newUri, forceLoad: false);
    }
}