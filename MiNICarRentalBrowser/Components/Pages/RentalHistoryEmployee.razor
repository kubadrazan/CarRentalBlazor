@page "/rentalhistory-employee"
@attribute [Authorize(Policy = "EmployeePolicy")]


@using SharedDataModels
@using Browser_FrontEnd.Services
@using System.Security.Claims
@using MiNICarRentalBrowser.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@rendermode RenderMode.InteractiveServer
@inject NavigationManager Navigation
@inject RentalServicecs rentalService
@inject IUserService userService
@inject AuthenticationStateProvider authenticationStateProvider
@inject IAuthorizationService AuthorizationService

<MudContainer>
    <MudGrid>
        <!-- Lista wypożyczeń -->
        <MudItem xs="12" sm="12" md="12">
            <MudGrid Class="mt-4" Spacing="12">
                @if (rentals.Any())
                {
                    <MudItem xs="12" Style="margin: 5px; margin: auto">
                        <MudText Typo="Typo.h5">Twoje wypożyczenia: @rentalsCount</MudText>
                    </MudItem>

                    @foreach (var rental in rentals)
                    {
                        <MudItem xs="12" Style="margin: 5px">
                            <MudPaper Class="p-4" Style="max-width: 600px; height: 125px; margin: auto" Elevation="4">
                                <MudGrid>
                                    <MudItem xs="7" sm="7">
                                        <div style="display: flex; flex-direction: column; align-items: flex-start; padding-left: 16px">
                                            <MudText Typo="Typo.h5">@rental.Car.Model.Brand.Name @rental.Car.Model.Name</MudText>
                                            <MudText Typo="Typo.body2" Class="my-1">Wypożyczony: @rental.RentDate.ToShortDateString()</MudText>
                                            @switch (rental.RentalStatus)
                                            {
                                                case RentalStatus.ACTIVE:
                                                    {
                                                        <MudText Typo="Typo.body2" Color="Color.Success" Class="my-1">Status: aktywne</MudText>
                                                        break;
                                                    }
                                                case RentalStatus.RETURNED:
                                                    {
                                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="my-1">Status: zwrócone</MudText>
                                                        break;
                                                    }
                                                case RentalStatus.CLOSED:
                                                    {
                                                        <MudText Typo="Typo.body2" Color="Color.Primary" Class="my-1">Status: zamknięte</MudText>
                                                        break;
                                                    }
                                            }
                                        </div>
                                    </MudItem>
                                    <MudItem xs="5" sm="5">
                                        <div style="display: flex; flex-direction: column; align-items: flex-end; padding-right: 16px">
                                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" OnClick="() => NavigateToRentalDetails(rental.ID)">Zobacz wypożyczenie</MudButton>
                                        </div>
                                    </MudItem>
                                </MudGrid>
                            </MudPaper>
                        </MudItem>
                    }
                }
                else if (isLoading)
                {
                    <MudItem xs="12" Style="margin: 5px; ">
                        <MudText Typo="Typo.h4" Color="Color.Primary" Class="text-center">Loading...</MudText>
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12" Style="margin: 5px">
                        <MudText Typo="Typo.h4" Color="Color.Secondary" Class="text-center">Brak wypożyczeń.</MudText>
                    </MudItem>
                }
            </MudGrid>
        </MudItem>
    </MudGrid>
</MudContainer>

<div class="mt-5 mb-5 d-flex flex-column align-center">
    <MudPagination ShowPageButtons="false" PageSize="@pageSize" Count="@pagesCount" SelectedChanged="OnPageChanged" />
</div>

@code {

    [Parameter]
    [SupplyParameterFromQuery(Name = "lastId")]
    public int? lastId { get; set; }

    public int newLastId = 0;

    private List<Rental> rentals = new List<Rental>();

    bool isLoading = false;

    private int pageSize = 15;

    private int rentalsCount = 0;

    private int pagesCount = 1;

    private void NavigateToRentalDetails(int rentalID)
    {
        Navigation.NavigateTo($"/RentalDetailsEmployee/{rentalID}", true);
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        rentalsCount = await rentalService.GetRentalsCountAsync();
        if (rentalsCount % pageSize == 0 && rentalsCount != 0)
            pagesCount = rentalsCount / pageSize;
        else
            pagesCount = rentalsCount / pageSize + 1;
    }

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        await base.OnParametersSetAsync();
        rentals = await rentalService.GetRentalsAsync(lastId, pageSize, false);
        isLoading = false;
    }

    private void OnPageChanged()
    {
        lastId = newLastId;
        UpdateUrl();
    }

    private void UpdateUrl()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        query.Remove("pageSize");
        query.Remove("lastId");

        query.Add("pageSize", pageSize.ToString());

        if (lastId.HasValue)
            query.Add("lastId", lastId.ToString());

        var newUri = $"{uri.GetLeftPart(UriPartial.Path)}?{query}";
        Navigation.NavigateTo(newUri, forceLoad: false);
    }
}