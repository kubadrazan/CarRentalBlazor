@page "/"
@using MudBlazor
@using System.Threading
@inject NavigationManager Navigation

<style>
    .centered {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }


    .centered-top {
        position: fixed;
        left: 50%;
        transform: translate(-50%, 0);
    }

    img.home {
        border-radius: 15px;
        margin: 10px
    }

    .home_btn {
        margin-left: 40px;
        margin-right: 40px;
    }

    .purple-accents > .mud-input-control-input-container > .mud-input.mud-input-outlined > /* input:focus ~ */ .mud-input-outlined-border {
        border-color: #A64DB6;
        border-width: 3px
    }

    .gray-accents > .mud-input-control-input-container > .mud-input.mud-input-outlined > /* input:focus ~ */ .mud-input-outlined-border {
        border-color: #808080;
        border-width: 3px
    }
</style>

<MudCard Class="centered rounded-xl" Style="padding-top:20px;
    padding-left:50px; padding-right:50px; padding-bottom:20px">
    <MudStack Row="true">
        <MudStack Style="width: 300px; height:300px; margin-top:50px; margin-right:20px"
                  Justify="Justify.Center">
            <MudSelect @bind-Value="_brand"
                       TextChanged="BrandChanged"
                       Label="Brand"
                       Clearable="true"
                       Variant=Variant.Outlined
                       Style="margin-top:15px"
                       Class="purple-accents">
                @foreach (var state in _states)
                {
                    <MudSelectItem Value="state">@state</MudSelectItem>
                }
            </MudSelect>

            @if (String.IsNullOrEmpty(_brand))
            {

                <MudSelect @bind-Value="_brand"
                        Label="Model"
                        Disabled="true"
                        Variant=Variant.Outlined
                        Style="margin-bottom:15px"
                        Class="gray-accents">
                </MudSelect>
            }
            else
            {
                <MudSelect @bind-Value="_model"
                        Label="Model"
                        Clearable="true"
                        Variant=Variant.Outlined
                        Style="margin-bottom:15px"
                        Class="purple-accents">
                    @foreach (var state in _states)
                    {
                        <MudSelectItem Value="state">@state</MudSelectItem>
                    }
                </MudSelect>
            }

            <button @onclick=SearchCar class="button home_btn">Search</button>
        </MudStack>

        <img class="home " src="landing_page_car.jpg" height="400" />
    </MudStack>
</MudCard>

@if (_showBrandAlert)
{
    <MudCard Class="centered-top rounded-xl">
        <MudAlert Class="rounded-xl" Severity="Severity.Error" ShowCloseIcon="true"
                  CloseIconClicked="(() => CloseAlert(true))">Car brand is required!</MudAlert>
    </MudCard>
}

@code {
    private string? _brand;
    private string? _model;
    private bool _showBrandAlert = false;

    private string[] _states =
    {
        "Alabama", "Alaska", "Arizona", "Arkansas", "California",
        "Colorado", "Connecticut", "Delaware", "Florida", "Georgia",
        "Hawaii", "Idaho", "Illinois", "Indiana", "Iowa", "Kansas",
        "Kentucky", "Louisiana", "Maine", "Maryland", "Massachusetts",
        "Michigan", "Minnesota", "Mississippi", "Missouri", "Montana",
        "Nebraska", "Nevada", "New Hampshire", "New Jersey", "New Mexico",
        "New York", "North Carolina", "North Dakota", "Ohio", "Oklahoma",
        "Oregon", "Pennsylvania", "Rhode Island", "South Carolina", "South Dakota",
        "Tennessee", "Texas", "Utah", "Vermont", "Virginia",
        "Washington", "West Virginia", "Wisconsin", "Wyoming"
    };

    private string[] _brands;
    private Dictionary<string, string[]> _models;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        _models = new();
        // todo get brands and models
    }

    protected async Task BrandChanged(string newValue)
    {
        _model = String.Empty;
    }

    private async Task SearchCar()
    {
        if (String.IsNullOrEmpty(_brand))
        {
            _showBrandAlert = true;
            await CloseAlertAfterDelay(10*1000);
        }
        else
        {
            _showBrandAlert = false;
            var uri = Navigation.ToAbsoluteUri("/car-browser");
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            query.Add("brand", _brand);
            if (!String.IsNullOrEmpty(_model))
                query.Add("model", _model);

            var newUri = $"{uri.GetLeftPart(UriPartial.Path)}?{query}";
            Navigation.NavigateTo(newUri);
            Navigation.NavigateTo(newUri);
        }
    }

    // todo add cancellation token
    public async Task CloseAlertAfterDelay(int delay)
    {
        await Task.Delay(delay);
        CloseAlert(true);
    }

    private void CloseAlert(bool value)
    {
        _showBrandAlert = !value;
    }
}