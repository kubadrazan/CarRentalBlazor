@page "/"
@using MudBlazor
@using System.Threading

<style>
    .centered {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }

    img.home {
        border-radius: 15px;
        margin: 10px
    }

    .home_btn {
        margin-left: 40px;
        margin-right: 40px;
    }

    .purple-accents > .mud-input-control-input-container > .mud-input.mud-input-outlined > /* input:focus ~ */ .mud-input-outlined-border {
        border-color: #A64DB6;
        border-width: 3px
    }
</style>

<MudCard Class="centered rounded-xl" Style="padding-top:20px;
    padding-left:50px; padding-right:50px; padding-bottom:20px">
    <MudStack Row="true">
        <MudStack Style="width: 300px; height:300px; margin-top:50px; margin-right:20px"
        Justify="Justify.Center">
            <MudAutocomplete T="string"
                             @bind-Value="_brand"
                             SearchFunc="SearchBrand"
                             Variant=Variant.Outlined
                             Label="Brand"
                             Placeholder="Choose car brand"
                             Clearable="true"
                             Style="margin-top:15px"
                             Class="purple-accents" />

            <MudAutocomplete T="string"
                             @bind-Value="_model"
                             SearchFunc="SearchModel"
                             Variant=Variant.Outlined
                             Label="Model"
                             Placeholder="Choose car model"
                             Clearable="true"
                             Style="margin-bottom:15px"
                             Class="purple-accents" />

            <button class="button home_btn" onclick="Search">Search</button>
        </MudStack>

        <img class="home "src="landing_page_car.jpg" height="400"/>
    </MudStack>
</MudCard>

@code {
    string _brand;
    string _model;

    private string[] _states =
    {
        "Alabama", "Alaska", "Arizona", "Arkansas", "California",
        "Colorado", "Connecticut", "Delaware", "Florida", "Georgia",
        "Hawaii", "Idaho", "Illinois", "Indiana", "Iowa", "Kansas",
        "Kentucky", "Louisiana", "Maine", "Maryland", "Massachusetts",
        "Michigan", "Minnesota", "Mississippi", "Missouri", "Montana",
        "Nebraska", "Nevada", "New Hampshire", "New Jersey", "New Mexico",
        "New York", "North Carolina", "North Dakota", "Ohio", "Oklahoma",
        "Oregon", "Pennsylvania", "Rhode Island", "South Carolina", "South Dakota",
        "Tennessee", "Texas", "Utah", "Vermont", "Virginia",
        "Washington", "West Virginia", "Wisconsin", "Wyoming"
    };

    private async Task<IEnumerable<string>> SearchBrand(string value, CancellationToken token)
    {
        // In real life use an asynchronous function for fetching data from an api.
        await Task.Delay(5, token);

        // if text is null or empty, show complete list
        if (string.IsNullOrEmpty(value))
            return _states;

        return _states.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task<IEnumerable<string>> SearchModel(string value, CancellationToken token)
    {
        // In real life use an asynchronous function for fetching data from an api.
        await Task.Delay(5, token);

        // if text is null or empty, show complete list
        if (string.IsNullOrEmpty(value))
            return _states;

        return _states.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    public void Search()
    {
        Console.WriteLine("Search");
    }
}