@using Browser_FrontEnd.Services
@using SharedDataModels
@using System.Globalization
@inject RentalServicecs renatalService
<div class="card">
	<h3>Returned Car Image</h3>
	@if (_base64data != null)
	{
		<MudImage Src="@_base64data" Width="300" Height="300" Alt="Image of car" Elevation="25" Class="rounded-lg" />
	}
	else
	{
		<MudCard Style="width: 300px; height: 300px" Elevation="25" Class="rounded-lg">
			<MudCardContent>
				<MudText Align="Align.Center">No File</MudText>
			</MudCardContent>
		</MudCard>
	}
</div>
@code {
	[Parameter]
	public required Rental rental { get; set; }

	private string _base64data { get; set; }
	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();
		if (rental != null)
		{
			var image = await renatalService.GetImage(rental.ID);
			if (image != null)
				_base64data = $"data:image/png;base64,{Convert.ToBase64String(image)}";
		}
	}
}
