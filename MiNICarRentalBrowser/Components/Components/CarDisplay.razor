@using SharedDataModels
@using System.Globalization
@if (car != null)
{
	@RenderStringProperty(car.Model?.Brand?.Name, "Brand")
	@RenderStringProperty(car.Model?.Name, "Model")
	@(RenderProperty<int>(car.ProductionYear, "Production Year"))
	@(RenderProperty<int>(car.DoorsNumber, "Doors"))
	@RenderStringProperty(car.Transmission, "Transmission")
	@RenderStringProperty(car.Colour, "Colour")
	@RenderStringProperty(car.Drive, "Drive")
	@RenderStringProperty(car.FuelType, "FuelType")
	@(RenderProperty<int>(car.HorsePower, "HorsePower", " HP"))
	@if (car.Location != null)
	{
		<p><strong>Location: </strong><a href="@_searchAddress">@($"{car.Location.Latitude}, {car.Location.Longitude}")</a></p>
	}
}
else
{
	<p>No Data</p>
}
@code {
	[Parameter]
	public required Car car { get; set; }

	private string _searchAddress { get; set; }
	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();
		if (car != null && car.Location != null)
			_searchAddress = $"https://www.google.com/maps/search/?api=1&query={car.Location.Latitude.ToString(CultureInfo.InvariantCulture)},{car.Location.Longitude.ToString(CultureInfo.InvariantCulture)}";
	}

	private MarkupString? RenderStringProperty(string? value, string label, string suffix = "")
	{
		if (string.IsNullOrEmpty(value))
		{
			return null;
		}

		var displayValue = char.ToUpper(value[0]) + value.Substring(1);
		return CreateMarkupString($"<p><strong>{label}:</strong> {displayValue}{suffix}</p>");
	}
	private MarkupString? RenderProperty<T>(T? value, string label, string suffix = "") where T : struct, IComparable<T>
	{
		if (!value.HasValue || value.Value.CompareTo(default(T)) == 0)
		{
			return null;
		}

		return CreateMarkupString($"<p><strong>{label}:</strong> {value.Value}{suffix}</p>");
	}

	private MarkupString CreateMarkupString(string content)
	{
		return new MarkupString(content);
	}
}
