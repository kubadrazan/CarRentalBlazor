@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuthorizationService AuthorizationService

<MudThemeProvider @rendermode="InteractiveServer" />
<MudPopoverProvider @rendermode="InteractiveServer" />
<MudDialogProvider @rendermode="InteractiveServer" />
<MudSnackbarProvider @rendermode="InteractiveServer" />

<MudLayout>
    <MudAppBar Color="Color.Primary" Fixed="false" Elevation="1">
        <MudButton DropShadow="false" Href="/" Color="Color.Inherit" Style="display: inline-flex; align-items: center; justify-content: left">
            <MudText Typo="Typo.h5" Class="ml-3" Style="display: inline-flex">MiNICarRental</MudText>
        </MudButton>
        <MudSpacer />
        <MudMenu Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" AriaLabel="Open menu">
            <MudMenuItem Icon="@Icons.Material.Filled.AccountCircle" IconSize="Size.Large">Account</MudMenuItem>
            <MudMenuItem OnClick="historyButtonOnClick" Icon="@Icons.Material.Filled.History" IconSize="Size.Large">Rental history</MudMenuItem>
            <MudMenuItem OnClick="logOutButtonOnClick" Icon="@Icons.Material.Filled.Logout" IconSize="Size.Large">Logout</MudMenuItem>
        </MudMenu>
    </MudAppBar>

    <MudMainContent>
        @Body
    </MudMainContent>

    <footer>
        <p>©MiNiCarRental 2024-2025</p>
        <p>Authors: Igor Kober, Kuba Drażan, Piotr Iśtok</p>
        <a href="mailto:minicarrental@hotmail.com">minicarrental@hotmail.com</a>
    </footer>
</MudLayout>

@code {
    private void logOutButtonOnClick()
    {
        Navigation.NavigateTo("/logout", forceLoad: true);
    }

    private async Task historyButtonOnClick()
    {
        bool IsEmployee;
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        IsEmployee = (await AuthorizationService.AuthorizeAsync(user, "EmployeePolicy")).Succeeded;

        if (IsEmployee)
            Navigation.NavigateTo("/rentalhistory-employee", forceLoad: true);
        else
            Navigation.NavigateTo("/rentalhistory-client", forceLoad: true);
    }
}

<style>
    footer {
        text-align: center;
        padding: 40px;
    }
</style>