@inherits LayoutComponentBase

<MudThemeProvider @rendermode="InteractiveServer" />
<MudPopoverProvider @rendermode="InteractiveServer" />
<MudDialogProvider @rendermode="InteractiveServer" />
<MudSnackbarProvider @rendermode="InteractiveServer" />

<MudLayout>
    <MudAppBar Color="Color.Primary" Fixed="false" Elevation="1">
        <MudButton DropShadow="false" Href="/" Color="Color.Inherit" Style="display: inline-flex; align-items: center; justify-content: left">
            <MudText Typo="Typo.h5" Class="ml-3" Style="display: inline-flex">MiNICarRental</MudText>
        </MudButton>
    </MudAppBar>

    <MudMainContent Style="padding-top: 20 px;">
        @Body
    </MudMainContent>

    <footer>
        <p>©MiNiCarRental 2024-2025</p>
        <p>Authors: Igor Kober, Kuba Drażan, Piotr Iśtok</p>
        <a href="mailto:minicarrental@hotmail.com">minicarrental@hotmail.com</a>
    </footer>
</MudLayout>

@code {

}

<style>
    footer {
        text-align: center;
        padding: 40px;
    }
</style>