@inherits LayoutComponentBase
@inject NavigationManager navigation

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Color="Color.Primary" Fixed="false">
        <MudNavLink Href="/" Match="NavLinkMatch.All">MiNICarRental</MudNavLink>
    </MudAppBar>

    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

@code {
	private async Task Login()
	{
		navigation.NavigateTo("/login", forceLoad: true);
	}

}