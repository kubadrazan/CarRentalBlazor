@inherits LayoutComponentBase
@inject NavigationManager navigation

<MudThemeProvider @rendermode="InteractiveServer" />
<MudPopoverProvider @rendermode="InteractiveServer" />
<MudDialogProvider @rendermode="InteractiveServer" />
<MudSnackbarProvider @rendermode="InteractiveServer" />

<MudLayout>
    <MudAppBar Color="Color.Primary" Fixed="false" Elevation="1">
        <MudNavLink Href="/" Match="NavLinkMatch.All"><MudText Typo="Typo.h5" Class="ml-3">MiNICarRental</MudText></MudNavLink>
        <MudSpacer />
        <MudButton DropShadow="false" StartIcon="@Icons.Material.Filled.AccountCircle" IconSize="Size.Large" Color="Color.Inherit">Account</MudButton>
    </MudAppBar>

    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

@code {
	private async Task Login()
	{
		navigation.NavigateTo("/login", forceLoad: true);
	}
	private async Task Logout()
	{
		navigation.NavigateTo("/logout", forceLoad: true);
	}

}